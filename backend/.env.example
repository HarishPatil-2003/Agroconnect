# ─────────────────────────────────────────────
# AgroConnect Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git — it is in .gitignore.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=your_mongodb_connection_string

# ── Auth Secrets ──────────────────────────────
# Strong random strings (min 32 chars each)
JWT_SECRET=your_jwt_secret_min_32_characters_long
REFRESH_SECRET=your_refresh_secret_min_32_characters_long

# ── Server ────────────────────────────────────
PORT=5001

# ── Frontend (for CORS whitelist on Render) ───
FRONTEND_URL=https://your-frontend.vercel.app

# ── Email / SMTP (Gmail) ──────────────────────
# Used by Nodemailer to send OTP verification emails.
#
# EMAIL_USER  → your Gmail address
# EMAIL_PASS  → 16-character Gmail App Password
#               (NOT your real Gmail password)
#               Generate one at:
#               https://myaccount.google.com/apppasswords
#               Enable 2-Step Verification first, then
#               create an App Password for "Mail".
#
# Optional overrides (defaults shown):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false    (set to true if using port 465)
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
